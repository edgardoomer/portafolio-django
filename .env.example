# ==========================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ==========================================================
# Copia este archivo como .env y rellena tus propios valores:
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
#
# El archivo .env real NUNCA se sube al repositorio.
# ==========================================================

# --- Django ---
# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pon-aqui-tu-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# En PRODUCCION (VM) seria algo asi:
#   DEBUG=False
#   ALLOWED_HOSTS=TU_IP_EXTERNA,tudominio.com,www.tudominio.com
#   CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com
#   SECURE_SSL_REDIRECT=False   # ponlo en True cuando ya tengas HTTPS (Certbot)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Proveedor de IA del chat ('deepseek' u 'openai') ---
IACHAT_PROVIDER=deepseek

# --- OpenAI (opcional) ---
# Obtenla en https://platform.openai.com/api-keys
OPENAI_API_KEY=pon-aqui-tu-clave-de-openai

# --- DeepSeek ---
# Obtenla en https://platform.deepseek.com
DEEPSEEK_API_KEY=pon-aqui-tu-clave-de-deepseek
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Base de datos ---
# 'sqlite' (recomendado en la VM, sin configuracion) o 'postgres' (local).
DB_ENGINE=sqlite
# Solo se usan si DB_ENGINE=postgres:
DB_NAME=cv_edgar
DB_USER=postgres
DB_PASSWORD=tu-password-de-postgres
DB_HOST=localhost
DB_PORT=5432

# --- Google reCAPTCHA ---
# Obtenlas en https://www.google.com/recaptcha/admin
RECAPTCHA_PUBLIC_KEY=tu-clave-publica
RECAPTCHA_PRIVATE_KEY=tu-clave-privada

# --- Chat IA ---
# Captcha del chat para visitantes anonimos (como en el registro).
# True en produccion; False en desarrollo para poder probar sin claves validas.
IACHAT_CAPTCHA_ENABLED=True

# --- Seguridad ---
# Ruta del admin: pon algo NO obvio en produccion (debe terminar en '/').
ADMIN_URL=admin/

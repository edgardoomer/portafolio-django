# Servicio systemd para Gunicorn (servidor de aplicaciones de Django).
# Copialo a /etc/systemd/system/gunicorn.service y AJUSTA:
#   - User=            tu usuario de la VM (el de la sesion SSH)
#   - WorkingDirectory y ExecStart: la ruta real donde clonaste el repo.
#
# Luego:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gunicorn
#   sudo systemctl status gunicorn

[Unit]
Description=Gunicorn - AskEdgar CV (Django)
After=network.target

[Service]
User=CAMBIA_USUARIO
Group=www-data
WorkingDirectory=/home/CAMBIA_USUARIO/portafolio-django
# Gunicorn escucha en local; Nginx hace de proxy por delante.
ExecStart=/home/CAMBIA_USUARIO/portafolio-django/.venv/bin/gunicorn \
    --workers 2 \
    --timeout 30 \
    --bind 127.0.0.1:8000 \
    mi_cv.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
